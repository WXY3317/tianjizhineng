# IDE / 编辑器（所有子目录）
.vscode/
**/.vscode/
.idea/
**/.idea/
*.swp
*.swo

# ROS2 编译产物
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# SDK 内的编译日志
tianji-robot-SDK/log/

# Python
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# 本地验证产物
ros2_ws/artifacts/

# 系统文件
.DS_Store
Thumbs.db

# 平台可执行文件
*.exe
*.dll
*.so

# SDK 随附的运行库
!tianji-robot-SDK/PYTHON_SDK/*.so
!tianji-robot-SDK/PYTHON_SDK/*.dll


# 真机独立 ROS 2 构建产物
ros2_ws/build_real/
ros2_ws/install_real/
ros2_ws/log_real/
