Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.25
      Plane Cell Count: 20
      Reference Frame: world
      Color: 100; 110; 125
      Alpha: 0.3
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: Tianji Whole Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
      Value: true
    - Class: rviz_default_plugins/TF
      Name: Frames
      Enabled: false
      Value: false
    - Class: rviz_default_plugins/TF
      Name: Palm TCP
      Enabled: true
      Value: true
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 0.10
      Frames:
        All Enabled: false
        palm_center_L:
          Value: true
        palm_center_R:
          Value: true
  Enabled: true
  Global Options:
    Background Color: 30; 35; 45
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.9
      Name: Orbit
      Near Clip Distance: 0.01
      Pitch: 0.45
      Target Frame: world
      Yaw: 0.8
