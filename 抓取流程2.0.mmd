flowchart TD
    START([等待新的非 retained MQTT]) --> LABEL{标签为无遮挡正面或无遮挡背面?}
    LABEL -- 否 --> START
    LABEL -- 是 --> ARM[按第一条 position1.Y 选臂<br/>Y≥0 左臂；Y<0 右臂]
    ARM --> FIRST_BODY[第一次抓取准备<br/>-10 cm≤Y≤10 cm：J6 左 -0.5／右 +0.5 rad<br/>position1.X≤60 cm：躯干 X 后移 25 cm<br/>position1.X≥75 cm：躯干 X 前移 25 cm]
    FIRST_BODY --> P1[抓取臂到 position1<br/>未运动前 IK 失败可尝试工具 Z 姿态]
    P1 --> P2{position2 有效且非全零?}
    P2 -- 否 --> STOP([未完成自动抓取：state=running<br/>不附着或回退])
    P2 -- 是 --> DOWN[等待 interval，保持法兰姿态<br/>沿直线下降到 position2]
    DOWN --> RESULT{下降结果}
    RESULT -- 规划被拒绝且尚未运动 --> RETRY{还有工具 Z 候选?<br/>最多追加 4 次}
    RETRY -- 是 --> P1
    RETRY -- 否 --> ERROR([/scene/status：state=failed<br/>event=rejected，停止])
    RESULT -- 运动中失败 --> ERROR
    RESULT -- 完成 --> GRIP[依次使能左右夹爪<br/>抓取侧张开至 27 mm 或电流保持]
    GRIP --> ATTACH[自动附着工件<br/>抓取臂退回 position1]
    ATTACH --> FIRST_KIND{第一条标签}

    FIRST_KIND -- 无遮挡正面 --> FRONT_RETURN[抓取臂 J1 到左 +1.5／右 -1.5 rad<br/>躯干 J4 按最新反馈 +0.15 rad<br/>双臂同步到 pre；必须恢复 body_photo]
    FIRST_KIND -- 无遮挡背面 --> BACK_RETURN[抓取臂 J1 到左 +1.5／右 -1.5 rad<br/>躯干 J4 按最新反馈 +0.15 rad<br/>抓取臂单独到 pre；必须恢复 body_photo]
    FRONT_RETURN --> FRONT_WAIT([等待第二条合法 MQTT])
    BACK_RETURN --> BACK_WAIT([等待第二条合法 MQTT])
    FRONT_WAIT --> FRONT_ARM[第二次固定用另一只手臂<br/>无论第二条标签正面或背面，均不交接]
    BACK_WAIT --> BODY_HOME[暂存第二条 MQTT<br/>躯干六轴到 body_home]
    BODY_HOME --> TRANSFER{第一次抓取臂}
    TRANSFER -- 左臂 --> RIGHT_RECEIVE[左臂到 left_post_grasp_joints<br/>右臂到 right_handover_joints，沿 +Y 靠近 6.5 cm<br/>右夹爪张开并持有第一件；左夹爪闭合]
    TRANSFER -- 右臂 --> LEFT_RECEIVE[右臂到 right_post_grasp_joints<br/>左臂到 left_handover_joints，沿 -Y 靠近 6.3 cm<br/>左夹爪张开并持有第一件；右夹爪闭合]
    RIGHT_RECEIVE --> TRANSFER_RETURN[接收臂退回交接预备位<br/>双臂同步回 pre，躯干到 body_photo]
    LEFT_RECEIVE --> TRANSFER_RETURN
    TRANSFER_RETURN --> BACK_ARM[重放第二条 MQTT<br/>第二次仍用第一次的抓取臂，不再交接]

    FRONT_ARM --> SECOND_SIDE{第二次抓取臂}
    BACK_ARM --> SECOND_SIDE
    SECOND_SIDE -- 右臂 --> RIGHT_Y{第二条 position1.Y}
    RIGHT_Y -- Y≥5 cm --> RIGHT_BIG[右臂到预备关节角<br/>关节角 -1.5, 0.8, 2.0, -1.0, 0, 0, 0<br/>J6 绝对目标 +1.57 rad]
    RIGHT_Y -- -10 cm≤Y<5 cm --> RIGHT_SMALL[J6 绝对目标 +0.5 rad]
    RIGHT_Y -- Y<-10 cm --> SECOND_X
    RIGHT_BIG --> SECOND_X
    RIGHT_SMALL --> SECOND_X
    SECOND_SIDE -- 左臂 --> LEFT_Y{第二条 position1.Y}
    LEFT_Y -- Y<-5 cm --> LEFT_BIG[左臂到预备关节角<br/>关节角 1.5, 0.8, -2.0, -1.0, 0, 0, 0<br/>J6 绝对目标 -1.57 rad]
    LEFT_Y -- -5 cm≤Y≤10 cm --> LEFT_SMALL[J6 绝对目标 -0.5 rad]
    LEFT_Y -- Y>10 cm --> SECOND_X
    LEFT_BIG --> SECOND_X
    LEFT_SMALL --> SECOND_X

    SECOND_X[按第二条 position1.X 决定躯干 X 是否前后平移 25 cm] --> SECOND_GRASP[第二次抓取：position1 → position2<br/>使能夹爪、张开、自动附着并退回 position1]
    SECOND_GRASP --> SECOND_RETURN[抓取臂 J1 到左 +1.5／右 -1.5 rad<br/>躯干 J4 按最新反馈 +0.15 rad<br/>双臂同步到 pre<br/>本次动过 J6 或平移过 X 时恢复 body_photo]
    SECOND_RETURN --> FINISH[躯干六轴回零<br/>双臂同步到 home<br/>左右夹爪依次闭合到 0 mm]
    FINISH --> DONE([/scene/status：state=success<br/>event=post_grasp_completed])
    FIRST_BODY -. 拒绝、故障或超时 .-> ERROR
    GRIP -. 反馈无效或超时 .-> ERROR
    SECOND_GRASP -. 拒绝、故障或超时 .-> ERROR

    classDef success fill:#e8f5e9,stroke:#388e3c,color:#111;
    classDef stopped fill:#ffebee,stroke:#c62828,color:#111;
    class DONE success;
    class ERROR,STOP stopped;
